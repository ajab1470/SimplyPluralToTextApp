<Window x:Class="SPETTApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPETTApp" xmlns:jsontotextconverter="clr-namespace:JsonToTextConverter;assembly=JsonToTextConverter" d:DataContext="{d:DesignInstance Type=jsontotextconverter:ViewModel}"
        mc:Ignorable="d"
        FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <LinearGradientBrush x:Key="CyanGradientBrush" StartPoint="0.5,0.2" EndPoint="0.5,1">
            <GradientStop Color="Cyan" Offset="0" />
            <GradientStop Color="DarkCyan" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>
    <Grid Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Name="InputFilePane" Grid.Row="1" Grid.Column="0" Margin="5">
            <TextBlock Margin="5" Text="Input:" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button Name="InputFileDialog" Height="30" MinWidth="30" Click="InputFileButton_Click" DockPanel.Dock="Right" TabIndex="1" IsTabStop="True"/>
            <TextBox Name="InputFileTextBox" Height="30" DockPanel.Dock="Left" ToolTip="InputFileHere" TabIndex="0" IsTabStop="True"
                     Text="{Binding InputJson}"/>
        </DockPanel>
        <Border Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" BorderThickness="2" BorderBrush="Gray">
            <StackPanel>
                <Label FontWeight="Bold">Settings!</Label>
                <TextBlock Margin="5" VerticalAlignment="Center">Alters per file:</TextBlock>
                <TextBox Name="AltersPerFileTextbox" VerticalAlignment="Center" Margin="5" TabIndex="3" ToolTip="Number of alters described in each text file created"/>
            </StackPanel>
        </Border>
        <DockPanel Name="OutputFilePane" Grid.Row="1" Grid.Column="2" Margin="5">
            <TextBlock Margin="5" Text="Output:" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button Name="OutputFileDialogue" Height="30" MinWidth="30" Click="OutputFileButton_Click" DockPanel.Dock="Right" TabIndex="3" IsTabStop="True"/>
            <TextBox Name="OutputFileTextBox" Height="30" DockPanel.Dock="Left" TabIndex="2" IsTabStop="True"
                     Text="{Binding OutputDirectory}"/>
        </DockPanel>
        <StackPanel Name="Button" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1">
            <Button Content="Go!" Click="Button_Click" TabIndex="4" IsTabStop="True" ToolTip="Convert your JSON!">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource CyanGradientBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
